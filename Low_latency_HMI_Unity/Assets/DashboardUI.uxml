<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/USS/Style.uss?fileID=7433441132597879392&amp;guid=dc17e353df950d248b4a026f8e0eb737&amp;type=3#Style"/>
    <ui:VisualElement style="flex-grow: 1; background-color: rgb(41, 44, 49); align-items: stretch; justify-content: flex-start; flex-direction: column; position: relative; align-self: stretch; flex-shrink: 1; top: auto; flex-basis: 300px; height: 300px;">
        <ui:Label text="Hi Yumeng," name="Greetings" style="height: 18px; width: 91px; border-left-width: 0; position: relative; top: auto; left: auto; flex-shrink: 1; background-color: rgba(79, 218, 79, 0); color: rgb(255, 255, 255); font-size: 9%; text-overflow: clip; letter-spacing: 2px; flex-grow: 0; align-items: stretch; margin-top: 14px; margin-left: 16px; padding-left: 0; padding-top: 0; padding-bottom: 0; margin-bottom: 0; padding-right: 0;"/>
        <ui:VisualElement name="greetings" style="flex-grow: 0; flex-direction: row;">
            <ui:Image name="wave" style="height: 21px; width: 21px; position: relative; right: auto; bottom: auto; background-color: rgba(228, 65, 65, 0); -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Image/image.png?fileID=2800000&amp;guid=534f7d39d177df44396178ba31b94d38&amp;type=3#image&quot;); background-size: contain; margin-left: 13px; top: -9%; margin-bottom: 0;"/>
            <ui:Label text="Welcome!" name="Welcome" style="top: auto; left: auto; background-color: rgba(178, 153, 153, 0); height: 20px; width: 80px; position: relative; right: auto; bottom: auto; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=2ff410c553a9b6f4ca9abdc3657f8eb1&amp;type=3#NotInter-Regular&quot;); -unity-font-style: normal; -unity-text-align: middle-left; font-size: 11.5px; -unity-text-outline-color: rgba(0, 0, 0, 0); text-overflow: clip; -unity-text-outline-width: 0; letter-spacing: 2px; word-spacing: 0; flex-shrink: 1; margin-top: 0; padding-top: 0; padding-left: 0; padding-bottom: 2px; margin-bottom: 2px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="dashboard-panel" style="position: absolute; top: 12%; left: 4%; width: 584px; height: 372px; background-color: rgb(22, 23, 27); border-top-left-radius: 11px; border-top-right-radius: 11px; border-bottom-left-radius: 11px; border-bottom-right-radius: 11px; flex-direction: column; padding-top: 8px; padding-left: 14px; padding-right: 14px; padding-bottom: 12px; margin-top: 6px; margin-bottom: 2px;">
            <ui:VisualElement name="Title" style="flex-grow: 0;">
                <ui:Label text="Real-Time HMI Monitor" name="Real-Time_HMI_Monitor" style="color: rgb(173, 179, 205); font-size: 11px; height: 24px; flex-shrink: 0; white-space: nowrap; width: 537px; padding-top: 1px; padding-bottom: 1px; position: relative;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Content" style="flex-grow: 1; flex-direction: row;">
                <ui:VisualElement name="Metrics" style="flex-grow: 0; margin-top: 10px;">
                    <ui:VisualElement name="metrics-row" style="flex-direction: row; margin-top: 0; flex-shrink: 1; padding-left: 12px; padding-bottom: 0; justify-content: flex-start; align-items: flex-start; width: 376px;">
                        <ui:VisualElement name="Raw_card" style="flex-grow: 1;">
                            <ui:Label text="Raw distance" name="Raw_distance" class="CustomLable distance_title" style="width: 98px; flex-shrink: 0; color: white; white-space: nowrap;"/>
                            <ui:Label text="- cm" name="Raw_value" class="CustomLable value" style="width: 96px; flex-shrink: 0; color: white; white-space: nowrap; margin-top: 6px; margin-bottom: 4px; margin-right: 4px; margin-left: 2px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="Output_card" style="flex-grow: 1;">
                            <ui:Label text="Output distance" name="Output_distance" class="CustomLable distance_title" style="width: 113px; flex-shrink: 0; color: white; white-space: nowrap;"/>
                            <ui:Label text="- cm" name="Output_value" class="CustomLable value" style="width: 101px; flex-shrink: 0; color: white; white-space: nowrap;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="graph-area" style="margin-top: 26px; flex-grow: 0; flex-direction: column; height: 206px; width: 373px; padding-left: 12px;">
                        <ui:Label text="Distance over time" name="distance_over_time" class="CustomLable" style="color: white; font-size: 13px; height: 24px; flex-shrink: 0; white-space: nowrap; width: 312px; -unity-text-align: middle-left; margin-top: 4px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Control_card" style="flex-grow: 0; flex-shrink: 0; width: 178px; margin-top: 10px;">
                    <ui:Label text="Controls" name="Controls" class="distance_title" style="color: white; font-size: 12.5px; white-space: nowrap; align-items: auto; -unity-text-align: middle-left; left: auto; -unity-font-style: bold; margin-bottom: 4px;"/>
                    <ui:Label text="Filter" name="Filter" class="lable_in_control" style="color: rgb(255, 255, 255); margin-bottom: 4px;"/>
                    <ui:DropdownField label="" class="dropdown" style="background-color: rgb(188, 188, 188); margin-top: 1px;"/>
                    <ui:VisualElement name="Alpha" style="flex-grow: 0; flex-direction: row; align-items: stretch; margin-top: 4px; padding-bottom: 0; margin-bottom: 2px;">
                        <ui:Label text="Alpha:" name="al" class="lable_in_control"/>
                        <ui:Label text="0.3" name="value" style="color: rgb(255, 255, 255); font-size: 12px; -unity-font-style: bold;"/>
                    </ui:VisualElement>
                    <ui:Slider label="" value="42" high-value="100" name="Alpha_Slider" style="color: rgb(255, 255, 255); -unity-text-outline-color: rgb(255, 255, 255); margin-bottom: 6px; margin-top: 0; width: 160px; background-color: rgb(34, 37, 43); height: 24px; border-top-left-radius: 9px; border-top-right-radius: 9px; border-bottom-right-radius: 9px; border-bottom-left-radius: 9px; border-left-color: rgb(188, 188, 188); border-right-color: rgb(188, 188, 188); border-top-color: rgb(188, 188, 188); border-bottom-color: rgb(188, 188, 188);"/>
                    <ui:Label text="UI update rate" name="UI_update_rate" class="lable_in_control"/>
                    <ui:DropdownField label="" class="dropdown" style="background-color: rgb(188, 188, 188); margin-top: 1px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
